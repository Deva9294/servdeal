# ⚠️ PRODUCTION ENVIRONMENT TEMPLATE
# Copy this to .env and fill in your actual values
# NEVER commit this file with real credentials

NODE_ENV=production
PORT=5000
SERVER_URL=https://your-production-backend-domain.com
CLIENT_URL=https://your-production-frontend-domain.com

# ========== DATABASE ==========
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/servdeal?retryWrites=true&w=majority

# ========== JWT CONFIGURATION ==========
JWT_SECRET=your_very_secure_random_jwt_secret_key_minimum_32_characters
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your_very_secure_random_jwt_refresh_secret_key_minimum_32_characters
JWT_REFRESH_EXPIRE=30d

# ========== OTP CONFIGURATION ==========
OTP_EXPIRE_MINUTES=10
OTP_EXPOSE_IN_RESPONSE=false

# ========== PAYMENT GATEWAY (RAZORPAY) ==========
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxx

# ========== SMS PROVIDER (MSG91 or TWILIO) ==========
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_OTP_TEMPLATE_ID=SRVDEL

# Alternative for Twilio:
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=your_twilio_sid
# TWILIO_AUTH_TOKEN=your_twilio_token
# TWILIO_PHONE_NUMBER=+1234567890

# ========== EMAIL SERVICE (SMTP & RESEND) ==========
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
EMAIL_FROM=noreply@servdeal.in

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx

# ========== IMAGE STORAGE (CLOUDINARY) ==========
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ========== SECURITY ==========
CORS_ORIGIN=https://your-production-frontend-domain.com
HELMET_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ========== LOGGING & MONITORING ==========
LOG_LEVEL=info
LOG_FILE=logs/servdeal.log
SENTRY_DSN=https://your-sentry-key@sentry.io/project-id

# ========== OPTIONAL: STRIPE (if using instead of Razorpay) ==========
# STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxx
# STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxx
